{
  "manifest_version": 3,
  "name": "claude-in-chrome-cli helper",
  "version": "0.1.0",
  "description": "Lets the cic command line move a tab you name into Claude's tab group. Reads tab and group lists; never drives a page.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
