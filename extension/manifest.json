{
  "manifest_version": 3,
  "name": "Yoke",
  "version": "0.1.0",
  "description": "Drives the Chrome you are already signed in to: every tab, real clicks and typing, page text and structure, console and network. Exposed to a local MCP server.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "scripting",
    "debugger"
  ],
  "background": {
    "service_worker": "browser/background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
